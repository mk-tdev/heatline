{
  "name": "heatline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live digital twin of an Abu Dhabi construction site for heat-stress warning, worker-first governance and decision rewind.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "api": "node --env-file=.env --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "golden:wbgt": "python3 -I scripts/wbgt-golden.py",
    "build": "npm run build:api && npm run build --workspace @heatline/web",
    "backtest": "node --import tsx scripts/backtest.ts",
    "build:api": "node scripts/build-api.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "openai": "^7.53.0",
    "zod": "^4.6.7"
  }
}
