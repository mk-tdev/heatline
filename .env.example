# Copy this file to .env and add your key. Without a key the app still runs:
# warnings use pre-written messages and the plan is built by the rules alone.
OPENAI_API_KEY=

# Optional
OPENAI_MODEL=gpt-6-luna            # model for the guardian, Noor and Omar
HEATLINE_MODEL_TTS=gpt-4o-mini-tts # model for the Listen button
HEATLINE_TTS_VOICE=coral
HEATLINE_API_PORT=8787
